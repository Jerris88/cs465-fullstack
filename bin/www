#!/usr/bin/env node

// Load environment variables early so JWT_SECRET is available app-wide
require('dotenv').config();

/**
 * Module dependencies.
 */

var app = require('../app'); // Main Express app
var debug = require('debug')('cs465-fullstack:server'); // Debug logger
var http = require('http'); // Node HTTP server

/**
 * Get port from environment and store in Express.
 * Defaults to 3000 if no PORT is set.
 */

var port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

/**
 * Create HTTP server using the Express app.
 */

var server = http.createServer(app);

/**
 * Listen on provided port, on all network interfaces.
 */

server.listen(port);
server.on('error', onError);       // Handle startup/server errors
server.on('listening', onListening); // Confirm server is running

/**
 * Normalize a port into a number, string, or false.
 * This allows flexibility for named pipes or numeric ports.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // Named pipe
    return val;
  }

  if (port >= 0) {
    // Valid port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 * Handles common startup errors clearly.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // Handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 * Confirms which port or pipe the server is running on.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
}