<div id="header">
    <div id="logo">
        <a href="/">
            <img src="/images/logo.png" alt="LOGO" height="100" width="200">
        </a>
    </div>

    <div id="navigation">
        <ul>
            <li>
                <a href="/" class="{{#if active_home}}selected{{/if}}">Home</a>
            </li>
            <li>
                <a href="/travel" class="{{#if active_travel}}selected{{/if}}">Travel</a>
            </li>
            <li>
                <a href="/news" class="{{#if active_news}}selected{{/if}}">News</a>
            </li>
            <li>
                <a href="/reservations">Reservations</a>
            </li>
            <li>
                <a href="http://localhost:4200" target="_blank" rel="noopener noreferrer">Admin</a>
            </li>
            <li>
                <a href="/checkout">Checkout</a>
            </li>

            <li>
                {{#if isLoggedIn}}
                    <span style="margin-right: 10px; font-size: 12px;">
                        Logged in as {{userEmail}}
                    </span>
                    <a href="/logout">Logout</a>
                {{else}}
                    <a href="/login">Login</a>
                {{/if}}
            </li>
        </ul>
    </div>
</div>