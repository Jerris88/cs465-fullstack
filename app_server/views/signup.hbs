<div style="width: 420px; margin: 0 auto; padding: 2rem 0;">
  <h1 style="text-align: center;">Sign Up</h1>

  {{#if error}}
    <p style="color: red;">{{error}}</p>
  {{/if}}

  <form method="POST" action="/signup">
    <div style="margin-bottom: 0.75rem;">
      <label for="name">Name</label><br />
      <input id="name" name="name" type="text" required style="width: 100%;" />
    </div>

    <div style="margin-bottom: 0.75rem;">
      <label for="email">Email</label><br />
      <input id="email" name="email" type="email" required style="width: 100%;" />
    </div>

    <div style="margin-bottom: 0.75rem;">
      <label for="password">Password</label><br />
      <input id="password" name="password" type="password" required style="width: 100%;" />
    </div>

    <div style="margin-bottom: 0.75rem;">
      <label for="password2">Re-type password</label><br />
      <input id="password2" name="password2" type="password" required style="width: 100%;" />
    </div>

    <div style="margin: 1rem 0;">
      <label>
        <input type="checkbox" name="agree" required />
        I agree to the <a href="/terms">Terms of Use</a> and <a href="/privacy">Privacy Policy</a>.
      </label>
    </div>

    <div style="display: flex; align-items: center; gap: 1rem;">
      <button type="submit">Sign up</button>
      <a href="/learn-more">Learn more</a>
    </div>
  </form>

  <p style="margin-top: 1rem;">
    Already have an account? <a href="/login">Login</a>
  </p>
</div>